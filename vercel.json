{
  "installCommand": "npm install --prefix app/frontend",
  "buildCommand": "npm run build --prefix app/frontend",
  "outputDirectory": "app/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
